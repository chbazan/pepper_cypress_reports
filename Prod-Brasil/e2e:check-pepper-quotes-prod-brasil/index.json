                  "code": "// Workaround error del logo de Mercap\ncy.get('.application-footer-logo-symbol').then($logos => {\n  cy.get('.collapse.navbar-collapse, .application-footer-container.hidden-xs.hidden-sm').then($containers => {\n    const containersArray = $containers.toArray();\n    const isLogoInsideContainer = [...$logos].some(logo => containersArray.some(container => container.contains(logo)));\n    if (!isLogoInsideContainer) {\n      cy.visit(_constants.default.PEPPER_LOCATION);\n    } else {\n      cy.log('El logo está en la ubicación correcta');\n    }\n  });\n});\n// Guardar en una variable la versión de Pepper\ncy.get('.pull-right .application-footer-link').invoke('text').then(text => {\n  const PEPPER_VERSION = text.trim();\n  cy.writeFile('pepper-version.txt', PEPPER_VERSION);\n});\n// Validaciones del Home\ncy.get('div.panel.cardPanel.panel-danger').should('be.visible');\ncy.get('div.panel-heading').contains('Bonos en 0 o más de 1 Curva').should('be.visible');\ncy.get('div.panel-heading').contains('Instrumentos sin especies').should('be.visible');",
